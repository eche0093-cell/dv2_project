{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": "Australian Healthcare Workforce Count by State/Territory (2024)",
  "width": 800,
  "height": 500,
  "projection": {
    "type": "mercator",
    "center": [134, -28],
    "scale": 700
  },
  "layer": [
    {
      "data": {
        "url": "https://raw.githubusercontent.com/rowanhogan/australian-states/master/states.geojson",
        "format": {"type": "json", "property": "features"}
      },
      "mark": {
        "type": "geoshape",
        "fill": "#e9ecef",
        "stroke": "#adb5bd",
        "strokeWidth": 1
      }
    },
    {
      "data": {
        "url": "https://raw.githubusercontent.com/eche0093-cell/dv2_project/main/data/workforce_region_map.csv"
      },
      "mark": {
        "type": "circle",
        "fill": "#1b365d",
        "opacity": 0.75,
        "stroke": "#1b365d",
        "strokeWidth": 1
      },
      "encoding": {
        "longitude": {"field": "longitude", "type": "quantitative"},
        "latitude": {"field": "latitude", "type": "quantitative"},
        "size": {
          "field": "count_2024",
          "type": "quantitative",
          "title": "Workforce Count (2024)",
          "scale": {"range": [100, 3000]}
        },
        "color": {
          "field": "state",
          "type": "nominal",
          "legend": null
        },
        "tooltip": [
          {"field": "state", "type": "nominal", "title": "State/Territory"},
          {"field": "count_2024", "type": "quantitative", "title": "Healthcare Workers (2024)", "format": ","}
        ]
      }
    }
  ]
}
