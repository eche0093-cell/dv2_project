{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Waffle chart: if Australia's health workforce were 100 people (SAMPLE DATA - replace with real shares).",
  "width": 320,
  "height": 320,
  "title": {
    "text": "If the health workforce were 100 people...",
    "subtitle": "Each square is one in every 100 registered practitioners",
    "anchor": "start"
  },
  "data": { "url": "https://raw.githubusercontent.com/eche0093-cell/dv2_project/main/data/Workforce_composition_sample.csv" },
  "transform": [
    { "calculate": "(datum.square - 1) % 10", "as": "col" },
    { "calculate": "floor((datum.square - 1) / 10)", "as": "row" }
  ],
  "mark": { "type": "rect", "cornerRadius": 2 },
  "encoding": {
    "x": {
      "field": "col",
      "type": "ordinal",
      "axis": null,
      "scale": { "paddingInner": 0.12, "paddingOuter": 0 }
    },
    "y": {
      "field": "row",
      "type": "ordinal",
      "axis": null,
      "scale": { "paddingInner": 0.12, "paddingOuter": 0 }
    },
    "color": {
      "field": "profession",
      "type": "nominal",
      "title": "Profession",
      "scale": {
        "domain": ["Nurses and midwives", "Allied health", "Doctors", "Dental practitioners", "Pharmacists"],
        "range": ["#1f6f8b", "#99c1b9", "#e07a5f", "#f2cc8f", "#8d6a9f"]
      },
      "legend": { "orient": "right" }
    },
    "tooltip": [{ "field": "profession", "title": "Profession" }]
  },
  "config": { "view": { "stroke": null } }
}
